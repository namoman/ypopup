<Window x:Class="Ypopup.App.Views.ReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y-popup - 쪽지 수신"
        Width="400"
        Height="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="PopupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#EF4444"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☎" Foreground="White" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="쪽지가 도착했습니다" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Foreground="White"
                            Click="CloseButton_Click"
                            Style="{StaticResource PopupHeaderButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Sender -->
            <Border Grid.Row="1" Background="#FFF7ED" Padding="14,10" BorderBrush="#FED7AA" BorderThickness="0,0,0,1">
                <TextBlock x:Name="SenderTextBlock"
                           Foreground="#9A3412"
                           FontWeight="SemiBold"
                           FontSize="12.5"/>
            </Border>

            <!-- Message -->
            <Border Grid.Row="2" Background="#FFFBEB" Margin="14,12,14,0" CornerRadius="8" BorderBrush="#FDE68A" BorderThickness="1">
                <TextBox x:Name="MessageTextBox"
                         IsReadOnly="True"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,8"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
            </Border>

            <!-- Attachments -->
            <ListBox x:Name="AttachmentListBox"
                     Grid.Row="3"
                     Margin="14,10,14,0"
                     MaxHeight="88"
                     MouseDoubleClick="AttachmentListBox_MouseDoubleClick"/>

            <!-- Footer -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="14,12,14,14">
                <Button x:Name="ReplyButton"
                        Click="ReplyButton_Click"
                        Padding="16,8"
                        Margin="0,0,8,0">
                    <TextBlock>
                        <Run Text="답장"/>
                        <Run Text=" (F2)" FontSize="10.5" Foreground="#E0FFFFFF"/>
                    </TextBlock>
                </Button>
                <Button Content="폴더 열기"
                        Click="OpenFolderButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Padding="16,8"/>
                <Button Click="CloseButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="16,8">
                    <TextBlock>
                        <Run Text="닫기"/>
                        <Run Text=" (Esc)" FontSize="10.5" Foreground="#94A3B8"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
