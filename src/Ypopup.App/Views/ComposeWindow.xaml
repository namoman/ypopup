<Window x:Class="Ypopup.App.Views.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Y-popup - 쪽지 보내기"
        Width="400"
        Height="420"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        AllowDrop="True"
        Drop="Window_Drop"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="PopupHeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF"
            CornerRadius="12"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#EF4444"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☎" Foreground="White" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="쪽지 보내기" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Foreground="White"
                            Click="CloseButton_Click"
                            Style="{StaticResource PopupHeaderButtonStyle}"/>
                </Grid>
            </Border>

            <!-- Recipient -->
            <Border Grid.Row="1" Background="#FFF7ED" Padding="14,10" BorderBrush="#FED7AA" BorderThickness="0,0,0,1">
                <TextBlock x:Name="RecipientTextBlock"
                           Foreground="#9A3412"
                           FontWeight="SemiBold"
                           FontSize="12.5"/>
            </Border>

            <!-- Message (sticky note feel) -->
            <Border Grid.Row="2" Background="#FFFBEB" Margin="14,12,14,0" CornerRadius="8" BorderBrush="#FDE68A" BorderThickness="1">
                <TextBox x:Name="MessageTextBox"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         AllowDrop="True"
                         Drop="MessageTextBox_Drop"
                         PreviewDragOver="MessageTextBox_PreviewDragOver"
                         PreviewKeyDown="MessageTextBox_PreviewKeyDown"/>
            </Border>

            <!-- Attachments -->
            <Grid Grid.Row="3" x:Name="AttachmentArea" Margin="14,10,14,0" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="AttachmentSummaryTextBlock"
                           FontSize="11"
                           Foreground="#64748B"
                           Margin="0,0,0,4"/>
                <ListBox x:Name="AttachmentListBox"
                         Grid.Row="1"
                         MaxHeight="72"
                         KeyDown="AttachmentListBox_KeyDown">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="제거" Click="RemoveAttachment_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="14,12,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="📎 파일 첨부"
                        Click="AttachButton_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        HorizontalAlignment="Left"
                        Padding="12,8"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="SendButton"
                            Click="SendButton_Click"
                            Padding="16,8"
                            Margin="0,0,8,0">
                        <TextBlock>
                            <Run Text="보내기"/>
                            <Run Text=" (F2 · Ctrl+Enter)" FontSize="10.5" Foreground="#E0FFFFFF"/>
                        </TextBlock>
                    </Button>
                    <Button Click="CloseButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="16,8">
                        <TextBlock>
                            <Run Text="닫기"/>
                            <Run Text=" (Esc)" FontSize="10.5" Foreground="#94A3B8"/>
                        </TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
