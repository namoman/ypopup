<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:Ypopup.Desktop.Views.Settings.Panels"
        x:Class="Ypopup.Desktop.Views.About.AboutWindow"
        Title="Y-popup 정보"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="#F3F5F9"
        Foreground="#1E293B">
    <Grid Margin="16,12,16,14" RowDefinitions="Auto,Auto">
        <panels:AboutSettingsPanel/>
        <Button Grid.Row="1" Content="닫기" Classes="secondary" HorizontalAlignment="Right"
                Width="84" Margin="0,8,0,0" IsDefault="True" Click="CloseButton_Click"/>
    </Grid>
</Window>
