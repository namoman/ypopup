<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Ypopup.Desktop.Controls"
        x:Class="Ypopup.Desktop.Views.Receive.ReceiveWindow"
        Title="Y-popup - 쪽지 수신"
        Width="400"
        Height="420"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent"
        KeyDown="Window_KeyDown">
    <Border Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Margin="8"
            BoxShadow="0 2 16 0 #2E000000">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    CornerRadius="12,12,0,0" PointerPressed="TitleBar_PointerPressed">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="☎" Foreground="#2563EB" FontSize="16" Margin="0,0,8,0"/>
                        <TextBlock Text="쪽지가 도착했습니다" Foreground="#1E293B" FontWeight="SemiBold" FontSize="13"/>
                    </StackPanel>
                    <Button Content="✕" HorizontalAlignment="Right"
                            Classes="popup-header" Click="CloseButton_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#EFF6FF" Padding="14,10" BorderBrush="#DBEAFE" BorderThickness="0,0,0,1">
                <TextBlock x:Name="SenderTextBlock" Foreground="#1E3A8A" FontWeight="SemiBold" FontSize="12.5"/>
            </Border>

            <Border Grid.Row="2" Background="#FFFFFF" Margin="14,12,14,0" CornerRadius="8"
                    BorderBrush="#E2E8F0" BorderThickness="1">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <controls:MessageBodyText x:Name="MessageBody" Padding="10,8"/>
                </ScrollViewer>
            </Border>

            <ListBox x:Name="AttachmentListBox"
                     Grid.Row="3"
                     Margin="14,10,14,0"
                     MaxHeight="88"
                     DoubleTapped="AttachmentListBox_DoubleTapped"/>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,12,14,14">
                <Button x:Name="ReplyButton" Click="ReplyButton_Click" Padding="16,8" Margin="0,0,8,0">
                    <TextBlock>
                        <Run Text="답장"/>
                        <Run Text=" (F2)" FontSize="10.5" Foreground="#E0FFFFFF"/>
                    </TextBlock>
                </Button>
                <Button Content="폴더 열기" Click="OpenFolderButton_Click" Classes="secondary"
                        Margin="0,0,8,0" Padding="16,8"/>
                <Button Click="CloseButton_Click" Classes="secondary" Padding="16,8">
                    <TextBlock>
                        <Run Text="닫기"/>
                        <Run Text=" (Esc)" FontSize="10.5" Foreground="#94A3B8"/>
                    </TextBlock>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
