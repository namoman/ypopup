<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Ypopup.Desktop.Controls"
        xmlns:vm="using:Ypopup.Desktop.ViewModels"
        x:Class="Ypopup.Desktop.Views.Chat.ChatRoomWindow"
        x:DataType="vm:ChatSessionViewModel"
        Title="{Binding RoomTitle}"
        Width="460" Height="620"
        MinWidth="380" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="💬" FontSize="18" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding RoomTitle}" FontWeight="Bold" FontSize="15" Foreground="#1E293B" />
                        <TextBlock Text="P2P LAN 암호화 통신" FontSize="11" Foreground="#64748B" />
                    </StackPanel>
                </StackPanel>
                <Button x:Name="LeaveButton" Grid.Column="1" Content="나가기" Classes="secondary"
                        IsVisible="False" VerticalAlignment="Center" Click="LeaveButton_Click"/>
            </Grid>
        </Border>

        <!-- 메시지 리스트 -->
        <ScrollViewer Grid.Row="1" x:Name="MessagesScrollViewer" Margin="12">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:MessageBubbleItem">
                        <StackPanel Margin="0,4">
                            <TextBlock Text="{Binding Content}"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       Margin="0,4"
                                       IsVisible="{Binding IsSystem}" />
                            <TextBlock Text="{Binding SenderName}"
                                       FontSize="11"
                                       Foreground="#666666"
                                       Margin="4,0,0,2"
                                       IsVisible="{Binding ShowSender}" />

                            <!-- 말풍선 -->
                            <Border CornerRadius="8"
                                    IsVisible="{Binding !IsSystem}"
                                    Padding="10,8"
                                    MaxWidth="320"
                                    HorizontalAlignment="{Binding BubbleAlignment}"
                                    Background="{Binding BubbleBackground}">
                                <StackPanel Spacing="4">
                                    <controls:MessageBodyText Message="{Binding Content}"
                                                              FontSize="13"
                                                              Foreground="{Binding ContentForeground}" />
                                    <TextBlock Text="{Binding FormattedTime}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Foreground="#888888" />
                                    <TextBlock Text="{Binding ReadCountText}"
                                               FontSize="10"
                                               HorizontalAlignment="Right"
                                               Foreground="{Binding ReadCountForeground}"
                                               IsVisible="{Binding ShowReadCount}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 하단 입력창 -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="12" Background="#FFFFFF">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto">
                <TextBox Grid.Column="0"
                         x:Name="InputTextBox"
                         Text="{Binding InputText, Mode=TwoWay}"
                         Watermark="메시지를 입력하세요 (Enter 전송)..."
                         AcceptsReturn="False"
                         KeyDown="InputTextBox_KeyDown"
                         Margin="0,0,8,0" />
                <Button Grid.Column="1"
                        Content="전송"
                        Padding="16,8"
                        Click="SendButton_Click" />
            </Grid>
        </Border>
    </Grid>
</Window>
