<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chat="using:Ypopup.Desktop.Views.Chat"
        x:Class="Ypopup.Desktop.Views.Chat.CreateRoomDialog"
        Title="새 그룹 대화방 / 단체 쪽지"
        Width="420" Height="540"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="대화방 제목" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="RoomTitleTextBox" Watermark="예: 개발팀 단톡방" />
        </StackPanel>

        <StackPanel x:Name="BodyPanel" Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="메시지 내용 (단체 쪽지)" FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBox x:Name="MessageBodyTextBox"
                     Watermark="단체 쪽지일 때 내용을 입력하세요"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="64" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" x:Name="SearchBox" Watermark="이름 또는 부서 검색..." TextChanged="SearchBox_TextChanged" Margin="0,0,8,0" />
            <Button Grid.Column="1" Content="전체 선택" Classes="secondary" Click="SelectAllButton_Click" Margin="0,0,4,0" />
            <Button Grid.Column="2" Content="해제" Classes="secondary" Click="DeselectAllButton_Click" />
        </Grid>

        <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Background="#FFFFFF">
            <ListBox x:Name="PeersListBox">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="chat:SelectablePeerItem">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Content="{Binding DisplayText}"
                                  HorizontalAlignment="Stretch" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Content="취소" Classes="secondary" Click="CancelButton_Click" Width="80" HorizontalContentAlignment="Center" />
            <Button Content="확인" Click="OkButton_Click" Width="80" HorizontalContentAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
