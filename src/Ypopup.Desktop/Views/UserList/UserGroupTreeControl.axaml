<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ypopup.Desktop.ViewModels"
             x:Class="Ypopup.Desktop.Views.UserList.UserGroupTreeControl"
             x:DataType="vm:UserGroupTreeViewModel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:GroupNodeItem">
                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              Margin="0,0,0,4"
                              Padding="4"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding HeaderText}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#1E293B" />
                        </Expander.Header>
                        <ListBox ItemsSource="{Binding Members}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="OnMemberSelectionChanged"
                                 DoubleTapped="OnMemberDoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:PeerNodeItem">
                                    <Border CornerRadius="8" Padding="8" Background="Transparent" HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Grid Grid.Column="0" Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Ellipse Fill="#E2E8F0" Width="40" Height="40"/>
                                                <TextBlock Text="👤" Foreground="#64748B" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" FontSize="18"/>
                                                <Ellipse Width="10" Height="10" Fill="#22C55E" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         IsVisible="{Binding !IsAway}"/>
                                                <Ellipse Width="10" Height="10" Fill="#F59E0B" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                         IsVisible="{Binding IsAway}"/>
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" Foreground="#1E293B"/>
                                                <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#0284C7" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2"
                                                    Content="📁"
                                                    ToolTip.Tip="공유폴더 열기"
                                                    Classes="icon"
                                                    Click="ShareFolderButton_Click"
                                                    Tag="{Binding}"
                                                    IsVisible="{Binding Peer.HasSharedFolder}"
                                                    VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
