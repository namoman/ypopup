<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ypopup.Desktop.ViewModels"
             x:Class="Ypopup.Desktop.Views.UserList.UserGroupTreeControl"
             x:DataType="vm:UserGroupTreeViewModel">
    <UserControl.Styles>
        <Style Selector="Expander.group /template/ ToggleButton">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:GroupNodeItem">
                    <Expander Classes="group"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              Margin="0"
                              Padding="0,0,0,2"
                              HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <TextBlock Text="{Binding HeaderText}"
                                       FontWeight="SemiBold"
                                       FontSize="12"
                                       Foreground="#64748B" />
                        </Expander.Header>
                        <ListBox Classes="peer-list"
                                 ItemsSource="{Binding Members}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 SelectionChanged="OnMemberSelectionChanged"
                                 DoubleTapped="OnMemberDoubleTapped">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem" x:DataType="vm:PeerNodeItem">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:PeerNodeItem">
                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Center">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,6,0"/>
                                        <Button Grid.Column="1"
                                                Classes="icon"
                                                Width="26"
                                                Height="26"
                                                MinHeight="0"
                                                Padding="0"
                                                Margin="0,0,8,0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                VerticalAlignment="Center"
                                                Tag="{Binding}"
                                                Click="AvatarButton_Click"
                                                DoubleTapped="AvatarButton_DoubleTapped"
                                                ToolTip.Tip="프로필 보기">
                                            <Panel Width="26" Height="26">
                                                <Border Width="26" Height="26" CornerRadius="13" ClipToBounds="True" Background="#E2E8F0">
                                                    <Grid>
                                                        <TextBlock Text="👤" Foreground="#64748B" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   IsVisible="{Binding !HasAvatar}"/>
                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                               IsVisible="{Binding HasAvatar}"/>
                                                    </Grid>
                                                </Border>
                                                <Ellipse Width="8" Height="8" Fill="#22C55E" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                         IsVisible="{Binding !IsAway}"/>
                                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                         HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                         IsVisible="{Binding IsAway}"/>
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   Foreground="#1E293B"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding IpAddress}"
                                                   FontSize="11"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,4,0"/>
                                        <Button Grid.Column="4"
                                                Content="📁"
                                                ToolTip.Tip="공유폴더 열기"
                                                Classes="icon"
                                                Padding="2"
                                                Click="ShareFolderButton_Click"
                                                Tag="{Binding}"
                                                IsVisible="{Binding Peer.HasSharedFolder}"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
