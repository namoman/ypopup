<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:userlist="using:Ypopup.Desktop.Views.UserList"
        x:Class="Ypopup.Desktop.Views.UserList.UserListWindow"
        Title="Y-popup - 사용자 목록"
        Width="340"
        Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        Background="Transparent">
    <Border Background="#F5FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Height="30" PointerPressed="TitleBar_PointerPressed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Y-popup LAN messenger" FontSize="11" Foreground="#64748B" FontWeight="Medium"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="—" Classes="titlebar" Click="MinimizeButton_Click"/>
                    <Button Content="✕" Classes="titlebar close" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16,8,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0" Background="Transparent"
                            Cursor="Hand" ToolTip.Tip="내 프로필" PointerPressed="SelfAvatar_PointerPressed">
                        <Panel>
                            <Border CornerRadius="18" ClipToBounds="True" Background="#E2E8F0">
                                <Grid>
                                    <TextBlock x:Name="SelfAvatarPlaceholder" Text="👤" FontSize="16" Foreground="#64748B"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image x:Name="SelfAvatarImage" Stretch="UniformToFill" IsVisible="False"/>
                                </Grid>
                            </Border>
                            <Ellipse x:Name="SelfStatusOnline" Width="10" Height="10" Fill="#22C55E" Stroke="White" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" IsHitTestVisible="False"/>
                            <Ellipse x:Name="SelfStatusAway" Width="10" Height="10" Fill="#F59E0B" Stroke="White" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1" IsHitTestVisible="False" IsVisible="False"/>
                        </Panel>
                    </Border>
                    <TextBlock x:Name="DisplayNameTextBlock" Grid.Column="1" FontSize="16" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <Button Grid.Column="1" Classes="icon" Click="SettingsButton_Click">
                    <TextBlock Text="⚙" FontSize="18" Foreground="#64748B"/>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="16,0,16,12">
                <TextBox x:Name="SearchTextBox" Padding="28,8,10,8" Background="#F1F5F9"
                         Foreground="#1E293B" BorderBrush="#E2E8F0" BorderThickness="1"
                         TextChanged="SearchTextBox_TextChanged"/>
                <TextBlock x:Name="SearchPlaceholderTextBlock" IsHitTestVisible="False"
                           Text="사용자·부서 검색..." VerticalAlignment="Center" HorizontalAlignment="Left"
                           Margin="30,0,0,0" Foreground="#64748B"/>
                <TextBlock Text="🔍" IsHitTestVisible="False" Foreground="#64748B" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0"/>
            </Grid>

            <Border Grid.Row="3" Margin="12,0,12,8"
                    Background="#F1F5F9" CornerRadius="10"
                    BorderBrush="#E2E8F0" BorderThickness="1" Padding="2">
                <userlist:UserGroupTreeControl x:Name="GroupTreeControl"/>
            </Border>

            <Grid Grid.Row="4" Margin="16,8,16,16" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SendButton" Content="쪽지 보내기" Click="SendButton_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Width="130"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="새로고침" Click="RefreshButton_Click" Margin="0,0,8,0"
                            Classes="secondary" Width="80"/>
                    <Button Content="닫기" Click="CloseButton_Click" Classes="secondary" Width="70"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
