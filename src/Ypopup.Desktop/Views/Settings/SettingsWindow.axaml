<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:Ypopup.Desktop.Views.Settings.Panels"
        x:Class="Ypopup.Desktop.Views.Settings.SettingsWindow"
        Title="Y-popup 설정"
        Width="500"
        Height="480"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#F8FAFC"
        Foreground="#1E293B">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0" SelectionChanged="SettingsTabControl_SelectionChanged">
            <TabItem Header="프로필">
                <panels:ProfileSettingsPanel x:Name="ProfilePanel"/>
            </TabItem>
            <TabItem Header="네트워크">
                <panels:NetworkSettingsPanel x:Name="NetworkPanel"/>
            </TabItem>
            <TabItem Header="일반">
                <panels:GeneralSettingsPanel x:Name="GeneralPanel"/>
            </TabItem>
            <TabItem Header="부재">
                <panels:AwaySettingsPanel x:Name="AwayPanel"/>
            </TabItem>
            <TabItem Header="About">
                <panels:AboutSettingsPanel x:Name="AboutPanel"/>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="취소" Width="80" Click="CancelButton_Click" Margin="0,0,8,0" Classes="secondary"/>
            <Button Content="저장" Width="80" IsDefault="True" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
