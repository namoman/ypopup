<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:panels="using:Ypopup.Desktop.Views.Settings.Panels"
        x:Class="Ypopup.Desktop.Views.Settings.SettingsWindow"
        Title="Y-popup 설정"
        Classes="settings"
        Width="520"
        Height="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Background="#F3F5F9"
        Foreground="#1E293B">
    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="SettingsTabControl" Grid.Row="0" Classes="fluent"
                    SelectionChanged="SettingsTabControl_SelectionChanged">
            <TabItem Header="프로필">
                <panels:ProfileSettingsPanel x:Name="ProfilePanel"/>
            </TabItem>
            <TabItem Header="네트워크">
                <panels:NetworkSettingsPanel x:Name="NetworkPanel"/>
            </TabItem>
            <TabItem Header="일반">
                <panels:GeneralSettingsPanel x:Name="GeneralPanel"/>
            </TabItem>
            <TabItem Header="부재">
                <panels:AwaySettingsPanel x:Name="AwayPanel"/>
            </TabItem>
            <TabItem Header="About">
                <panels:AboutSettingsPanel x:Name="AboutPanel"/>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" Width="84" Click="CancelButton_Click" Margin="0,0,8,0" Classes="secondary"/>
                <Button Content="저장" Width="84" IsDefault="True" Click="SaveButton_Click" Classes="accent"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
