<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ypopup.Desktop.Views.Settings.Panels.ProfileSettingsPanel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="사진" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Border Width="48" Height="48" CornerRadius="24" ClipToBounds="True" Background="#E2E8F0" Margin="0,0,10,0">
                        <Grid>
                            <TextBlock x:Name="AvatarPlaceholder" Text="👤" FontSize="20" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Image x:Name="AvatarPreview" Stretch="UniformToFill"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="그림 선택" Classes="secondary" Click="PickAvatar_Click" Padding="10,4" MinHeight="0"/>
                        <Button x:Name="ClearAvatarButton" Content="사진 제거" Classes="secondary" Click="ClearAvatar_Click"
                                Padding="10,4" MinHeight="0" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="표시 이름" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" ColumnDefinitions="*,8,88">
                    <TextBox x:Name="DisplayNameTextBox" Grid.Column="0"/>
                    <TextBox x:Name="JobTitleTextBox" Grid.Column="2" Watermark="직급"/>
                </Grid>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="그룹" VerticalAlignment="Center"/>
                <TextBox x:Name="GroupTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
                <CheckBox x:Name="OnlySameGroupCheckBox" Grid.Row="3" Grid.Column="1"
                          Content="같은 그룹 사용자만 목록에 표시" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="이메일" VerticalAlignment="Center"/>
                <TextBox x:Name="EmailTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="5" Grid.Column="0" Text="메모" VerticalAlignment="Top" Margin="0,4,0,0"/>
                <TextBox x:Name="MemoTextBox" Grid.Row="5" Grid.Column="1"
                         MinHeight="100" AcceptsReturn="True" TextWrapping="Wrap"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
