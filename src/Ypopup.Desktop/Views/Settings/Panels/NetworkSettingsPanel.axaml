<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ypopup.Desktop.Views.Settings.Panels.NetworkSettingsPanel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <Border Background="#EFF6FF" BorderBrush="#DBEAFE" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <TextBlock Text="포트 변경은 프로그램 재시작 후 적용됩니다."
                           Foreground="#1E3A8A" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1"
                    CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                <TextBlock Text="탐색 포트(UDP)는 같은 LAN의 모든 PC가 동일해야 합니다. 포트가 다르면 서로를 찾지 못해 통신이 되지 않을 수 있습니다."
                           Foreground="#92400E" FontSize="12" TextWrapping="Wrap"/>
            </Border>
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="공개 IP" VerticalAlignment="Center"/>
                <AutoCompleteBox x:Name="LocalIpComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                 FilterMode="None"
                                 ToolTip.Tip="다중 랜카드 PC에서 다른 PC가 접속할 IP"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="UDP 탐색 포트" VerticalAlignment="Center"/>
                <TextBox x:Name="DiscoveryPortTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="TCP 메시지 포트" VerticalAlignment="Center"/>
                <TextBox x:Name="TcpPortTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="TCP 공유폴더 포트" VerticalAlignment="Center"
                           ToolTip.Tip="공유폴더 HTTP 서비스 포트"/>
                <TextBox x:Name="ShareFolderPortTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>
            </Grid>
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12">
                <StackPanel>
                    <TextBlock Text="Windows 방화벽" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="LAN 탐색(UDP), 메시지(TCP), 공유폴더(TCP) 수신을 위해 방화벽 허용이 필요합니다.&#x0a;처음 실행 시 허용 창에서 차단했다면 아래 버튼을 사용하세요."
                               Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="FirewallStatusTextBlock" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock x:Name="FirewallExePathTextBlock" Foreground="#64748B" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="방화벽 허용 추가 (관리자)" MinWidth="0" Padding="6,6" FontSize="12"
                                Margin="0,0,6,0" Click="AddFirewallRuleButton_Click"/>
                        <Button Content="Windows 방화벽 설정 열기" Classes="secondary" MinWidth="0" Padding="6,6" FontSize="12"
                                Margin="0,0,6,0" Click="OpenFirewallSettingsButton_Click"/>
                        <Button Content="상태 새로고침" Classes="secondary" MinWidth="0" Padding="6,6" FontSize="12"
                                Click="RefreshFirewallStatusButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
