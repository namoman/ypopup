<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Ypopup.Desktop.Views.Settings.Panels.AboutSettingsPanel">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,8,4,4">
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="14" Margin="0,0,0,12">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="40" Height="40" Background="#2563EB" CornerRadius="10" VerticalAlignment="Center">
                        <TextBlock Text="☎" Foreground="White" FontSize="18" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Y-popup" FontSize="16" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="#DBEAFE" CornerRadius="8" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock x:Name="VersionTextBlock" FontSize="11" Foreground="#1E40AF"/>
                            </Border>
                            <Border Background="#F1F5F9" CornerRadius="8" Padding="8,2">
                                <TextBlock Text=".NET 8 · Avalonia" FontSize="11" Foreground="#475569"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Padding="12">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="88,*">
                    <TextBlock Grid.Row="0" Text="제작자" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="namoman" VerticalAlignment="Center"/>
                        <Button Content="namolove@gmail.com" Classes="link" Margin="8,0,0,0"
                                VerticalAlignment="Center" Click="EmailLink_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="공식 사이트" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="namoman.github.io/ypopup" Classes="link"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Click="WebsiteLink_Click"/>

                    <TextBlock Grid.Row="2" Text="GitHub" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,0,8"/>
                    <Button Grid.Row="2" Grid.Column="1" Content="github.com/namoman/ypopup" Classes="link"
                            HorizontalAlignment="Left" Margin="0,0,0,8" Click="RepositoryLink_Click"/>

                    <TextBlock Grid.Row="3" Text="라이선스" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="MIT" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
