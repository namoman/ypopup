<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Ypopup.Core.Models"
        xmlns:controls="using:Ypopup.Desktop.Controls"
        x:Class="Ypopup.Desktop.Views.SharedFolder.SharedFolderWindow"
        Title="Y-popup - 공유폴더"
        Width="480"
        Height="460"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#1E293B">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock" Grid.Row="0" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="↑ 상위" Click="UpButton_Click" Margin="0,0,8,0" Padding="10,4"/>
            <TextBlock x:Name="PathTextBlock" VerticalAlignment="Center" Foreground="#64748B"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <ListBox x:Name="EntryListBox"
                 Grid.Row="2"
                 DoubleTapped="EntryListBox_DoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:SharedFolderEntry">
                    <TextBlock Text="{Binding ListLabel}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" x:Name="ProgressArea" Margin="0,12,0,0" IsVisible="False">
            <controls:TransferProgressBar x:Name="ProgressBarControl" Progress="0"/>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="DownloadButton" Content="다운로드" Click="DownloadButton_Click" Margin="0,0,8,0"/>
            <Button Content="닫기" Click="CloseButton_Click" Classes="secondary"/>
        </StackPanel>
    </Grid>
</Window>
