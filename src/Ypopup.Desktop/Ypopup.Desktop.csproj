<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ypopup.Desktop</RootNamespace>
    <AssemblyName>Y-popup</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Authors>namoman</Authors>
    <Company>namoman</Company>
    <Product>Y-popup</Product>
    <Description>X-Popup 오마주 LAN 메신저 (Avalonia)</Description>
    <Version>1.2.0</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ypopup.Core\Ypopup.Core.csproj" />
    <ProjectReference Include="..\Ypopup.Network\Ypopup.Network.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
</Project>
